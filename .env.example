# GBar Dashboard Auth
# Option 1: Manual cookie (copy from browser DevTools)
# Open DevTools → Network → reload page → click first request → Headers → Cookie
GBAR_COOKIE_STRING=

# Option 2: Auto-login (recommended — cookies refresh automatically)
GBAR_LOGIN=your_gbar_login_here
GBAR_PASSWORD=your_gbar_password_here

# Telegram Bot
# 1. Message @BotFather on Telegram, send /newbot
# 2. Follow instructions, get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID
# Message @userinfobot on Telegram to get your chat_id
TELEGRAM_CHAT_ID=your_chat_id_here

# Polling interval in minutes (default: 5)
POLL_INTERVAL_MINUTES=5

# How many days ahead to check (default: 7)
DAYS_AHEAD=7

# Base URL of the dashboard
GBAR_BASE_URL=https://pro.gbar.com.ua

# Optional: path to Chromium binary for Puppeteer (for VPS without bundled Chrome)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
