# GBar Dashboard Auth
# Copy your session cookie from browser DevTools:
# 1. Open https://pro.gbar.com.ua/issue/master
# 2. Open DevTools (F12) → Application → Cookies
# 3. Copy the value of the cookie named "gbar_session" (or similar laravel_session)
GBAR_SESSION_COOKIE=your_session_cookie_here

# The full cookie string from the request header (alternative to above)
# Open DevTools → Network → reload page → click first request → Headers → Cookie
GBAR_COOKIE_STRING=your_full_cookie_string_here

# Telegram Bot
# 1. Message @BotFather on Telegram, send /newbot
# 2. Follow instructions, get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID
# 1. Message @userinfobot on Telegram to get your chat_id
# Or message your bot, then visit:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Polling interval in minutes (default: 5)
POLL_INTERVAL_MINUTES=5

# How many days ahead to check (default: 7)
DAYS_AHEAD=7

# Base URL of the dashboard
GBAR_BASE_URL=https://pro.gbar.com.ua
